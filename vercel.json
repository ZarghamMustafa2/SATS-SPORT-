    { "source": "/Reports/:match*", "destination": "/admin.html" },
    { "source": "/Markets/:match*", "destination": "/admin.html" },
    { "source": "/Common/:match*", "destination": "/admin.html" },
    { "source": "/Customer/:match*", "destination": "/admin.html" }
  ]
