# SatsSport Fixed-IP Egress Server Configuration

# Server Port and Host
PORT=4000
HOST=0.0.0.0

# Shubdx International API Configuration
# Replace with official Shubdx URL (default: https://shubdxinternational.com)
SHUBDX_API_BASE_URL=https://shubdxinternational.com

# Shubdx API Key (if provided by Shubdx account manager, keep server-side only)
SHUBDX_API_KEY=

# Server Mode: 'standalone' (runs on VPS with fixed IP) or 'proxy' (forwards to upstream proxy)
SHUBDX_SERVER_MODE=standalone

# Active Sports Data Provider: 'shubdx' (default) or 'diamond' (requires authorization)
SPORTS_DATA_PROVIDER=shubdx

# Optional: If running on Vercel and routing to your fixed-IP VPS, set this on Vercel:
# SHUBDX_PROXY_URL=http://YOUR_VPS_PUBLIC_IP:4000
# SHUBDX_SERVER_MODE=proxy

# Diamond Betting API Configuration
DIAMOND_API_BASE_URL=http://46.202.166.33:3009
DIAMOND_API_KEY=

